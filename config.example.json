{
  "model": { "providerID": "deepseek", "modelID": "deepseek-flash" },
  "models": [
    "deepseek/deepseek-flash",
    "deepseek/deepseek-v4-pro",
    "moonshotai-cn/kimi-k2.7-code",
    "moonshotai-cn/kimi-k2.6",
    "moonshotai-cn/kimi-k2.7-code-highspeed",
    "moonshotai-cn/kimi-k3"
  ],
  "daemon": { "url": "", "username": "", "password": "" },
  "accounts": [
    { "user_id": "<feishu-user-id>", "name": "YZ", "trust": "superuser" }
  ],
  "bots": [
    {
      "name": "KILO-LOCUS-A",
      "directory": "/home/zhengyp/work/B/locus",
      "session": "",
      "ack": "always"
    },
    {
      "name": "KILO-DOCTOR",
      "directory": "/home/zhengyp/codex/withdrawal-reactions",
      "session": "",
      "autoHandoff": {
        "thresholdK": 120,
        "timeoutSec": 120,
        "retryDeltaK": 20,
        "message": "[自动交接] 上一个诊疗会话 {oldSession} 上下文已达 {tokens}K，现由你无缝接续。请先读取本工程的 AGENTS.md、visitor/index.md 与当前来访者的 profile.md（唯一信息源），再接续处理随后来自飞书的患者消息；不要向患者提及本次自动交接。"
      }
    }
  ],
  "queue": { "maxWaitMs": 900000, "coalesceMs": 700 },
  "timers": { "maxActive": 20, "minIntervalSec": 10 },
  "contextWatch": { "maxActive": 10, "intervalSec": 60, "minIntervalSec": 15 },
  "terminal": { "maxOutput": 262144, "defaultObserveLimit": 8192 },
  "permissions": {
    "allow": [
      { "permission": "bash", "pattern": "ls*" },
      { "permission": "bash", "pattern": "git status*" },
      { "permission": "bash", "pattern": "git diff*" },
      { "permission": "bash", "pattern": "git log*" }
    ],
    "approvalTimeoutSec": 300,
    "maxRetries": 3
  },
  "control": { "port": 4180, "token": "" },
  "wake": { "mode": "async" },
  "phone": {
    "number": "COGOS002:A0006",
    "dataDir": "~/.cogos/kilo-phone",
    "cogosDir": "<path to cogos checkout>",
    "contacts": { "YZ": ["COGOS002:H0002"], "唐钰": ["COGOS002:A0005"] },
    "python": "python3.11",
    "maxConsecutive": 5
  }
}
