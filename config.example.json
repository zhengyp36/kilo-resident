{
  "model": { "providerID": "deepseek", "modelID": "deepseek-v4-flash" },
  "daemon": { "url": "", "username": "", "password": "" },
  "accounts": [
    { "user_id": "<feishu-user-id>", "name": "YZ", "trust": "superuser" }
  ],
  "bots": [
    {
      "name": "KILO-LOCUS-B",
      "directory": "/path/to/project-b",
      "session": ""
    },
    {
      "name": "KILO-DOCTOR",
      "directory": "/path/to/doctor-project",
      "session": ""
    }
  ],
  "queue": { "maxWaitMs": 900000 },
  "timers": { "maxActive": 20, "minIntervalSec": 10 },
  "terminal": { "maxOutput": 262144, "defaultObserveLimit": 8192 },
  "permissions": {
    "allow": [
      { "permission": "bash", "pattern": "ls*" },
      { "permission": "bash", "pattern": "git status*" },
      { "permission": "bash", "pattern": "git diff*" },
      { "permission": "bash", "pattern": "git log*" }
    ],
    "approvalTimeoutSec": 300
  },
  "control": { "port": 4180, "token": "" },
  "wake": { "mode": "async" }
}
